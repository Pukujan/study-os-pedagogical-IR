{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://study-os.local/schemas/pir.coverage-report.v1.schema.json",
  "title": "PIR CoverageReport v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "ledger_id",
    "extraction_revision",
    "expected_source_turn_count",
    "disposition_record_count",
    "unique_disposed_source_turn_count",
    "missing_turn_ids",
    "duplicate_turn_ids",
    "unknown_turn_ids",
    "duplicate_disposition_ids",
    "revision_mismatched_disposition_ids",
    "duplicate_authoritative_turn_ids",
    "complete"
  ],
  "properties": {
    "schema_version": {"const": "pir.coverage-report.v1"},
    "ledger_id": {"type": "string", "minLength": 1},
    "extraction_revision": {"type": "string", "minLength": 1},
    "expected_source_turn_count": {"type": "integer", "minimum": 0},
    "disposition_record_count": {"type": "integer", "minimum": 0},
    "unique_disposed_source_turn_count": {"type": "integer", "minimum": 0},
    "missing_turn_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "duplicate_turn_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "unknown_turn_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "duplicate_disposition_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "revision_mismatched_disposition_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "duplicate_authoritative_turn_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "complete": {"type": "boolean"}
  }
}
